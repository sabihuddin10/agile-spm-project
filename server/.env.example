# Copy to server/.env (git-ignored) and fill in. Loaded by `dotenv/config` in src/index.js
# and scripts/db-reset.js. Never commit the real .env.

# Port the API listens on locally.
PORT=4000

# Secret used to sign login tokens. Use a long random string, different per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production, and it must not be the built-in fallback (that one is for local development and tests).
# Use at least 32 characters: a shorter one only logs a [config] warning in production, unless STRICT_PRODUCTION_CONFIG=1.
JWT_SECRET=

# Postgres connection string. Required in production. Leave empty locally to run fully in memory (seed data, lost on restart).
# The driver follows the host (src/data/db.js):
#   - local dev, a PostgreSQL on this PC (standard pg driver over TCP):
#       DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/agspm
#   - production, set only in the Vercel API project settings (Neon serverless driver):
#       DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# The app creates its app_state table on first request; create the database itself once
# (e.g. in pgAdmin, or: psql -U postgres -c "CREATE DATABASE agspm").
DATABASE_URL=

# Which saved state row to load/save in Postgres (lets several environments share one database).
STATE_KEY=main

# Where the sign-in, registration and public-form rate limit counters live (docs/rate-limiting.md).
# Leave empty: "postgres" (a table every API instance shares) when DATABASE_URL is set, "memory"
# (this process only) otherwise. Set it only to force one. A production API using "memory" logs a warning.
RATE_LIMIT_STORE=

# Set to 1 on a production deployment once its JWT_SECRET (32+ characters) and DATABASE_URL are known to be
# right: a short secret or a missing database then refuse to start instead of only logging a [config] warning.
STRICT_PRODUCTION_CONFIG=
