# Copy to server/.env (git-ignored) and fill in. Loaded by `dotenv/config` in src/index.js
# and scripts/db-reset.js. Never commit the real .env.

# Port the API listens on locally.
PORT=4000

# Secret used to sign login tokens. Use a long random string, different per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Falls back to an insecure dev secret when empty.
JWT_SECRET=

# Neon Postgres connection string. Leave empty to run fully in memory (seed data, lost on restart).
# Example: postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Which saved state row to load/save in Postgres (lets several environments share one database).
STATE_KEY=main
