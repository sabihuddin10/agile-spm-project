# Copy to server/.env (git-ignored) and fill in. Loaded by `dotenv/config` in src/index.js
# and scripts/db-reset.js. Never commit the real .env.

# Port the API listens on locally.
PORT=4000

# Secret used to sign login tokens. Use a long random string, different per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Falls back to an insecure dev secret when empty.
JWT_SECRET=

# Postgres connection string. Leave empty to run fully in memory (seed data, lost on restart).
# The driver follows the host (src/data/db.js):
#   - local dev, a PostgreSQL on this PC (standard pg driver over TCP):
#       DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/agspm
#   - production, set only in the Vercel API project settings (Neon serverless driver):
#       DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# The app creates its app_state table on first request; create the database itself once
# (e.g. in pgAdmin, or: psql -U postgres -c "CREATE DATABASE agspm").
DATABASE_URL=

# Which saved state row to load/save in Postgres (lets several environments share one database).
STATE_KEY=main
