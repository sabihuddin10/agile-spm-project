{
  "name": "@restaurant-platform/server",
  "version": "1.0.0",
  "private": true,
  "description": "Express 4 REST API for the Restaurant Operations & Ordering Platform (in-memory store, persisted to Neon Postgres when DATABASE_URL is set)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch-path=src src/index.js",
    "start": "node src/index.js",
    "test": "node --test test/*.test.js test/*/*.test.js",
    "lint": "node scripts/check-syntax.js",
    "test:db": "node --test --test-concurrency=1 test-db/*.test.js",
    "db:reset": "node scripts/db-reset.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
