# Copy to frontend/.env.local (git-ignored) and fill in. Next.js loads it automatically.
# Only NEXT_PUBLIC_* values reach the browser; never put secrets in them.

# Where the Next.js server proxies /api/* to (next.config.mjs rewrites) and what /api/health checks.
API_URL=http://localhost:4000

# true = the Workforce screens use built-in mock data instead of the API.
NEXT_PUBLIC_WORKFORCE_MOCK=false
